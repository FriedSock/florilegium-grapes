\NeedsTeXFormat{LaTeX2e}[2020-10-01]
\ProvidesPackage{florilegium-grapes}[2026/11/22 v3.0.0 a grapevine in the page margin, Lua-drawn]
\ifdefined\directlua\else
  \PackageError{florilegium-grapes}{florilegium-grapes needs LuaLaTeX}{Compile with lualatex.}\endinput\fi
\RequirePackage{tikz}
\RequirePackage{eso-pic}

\newif\ifflorilegiumgrapes@aging
\DeclareOption{aging}{\florilegiumgrapes@agingtrue}
%% key=value option: vine=<variety>
\def\florilegiumgrapes@vine{}
\DeclareOption*{\expandafter\florilegiumgrapes@option\CurrentOption==\@nil}
\def\florilegiumgrapes@option#1=#2=#3\@nil{%
  \ifcsname florilegiumgrapes@set@#1\endcsname\csname florilegiumgrapes@set@#1\endcsname{#2}%
  \else\PackageWarning{florilegium-grapes}{Unknown option `\CurrentOption'}\fi}
\def\florilegiumgrapes@set@vine#1{\def\florilegiumgrapes@vine{#1}}
\def\florilegiumgrapes@pruning{}
\def\florilegiumgrapes@set@pruning#1{\def\florilegiumgrapes@pruning{#1}}
\ProcessOptions\relax
\ifdefined\florilegiumgrapesseed\else\def\florilegiumgrapesseed{}\fi

\directlua{florilegiumgrapes = require("florilegium-grapes")}
\ifx\florilegiumgrapes@vine\@empty\else
  \directlua{florilegiumgrapes.vine = "\luaescapestring{\florilegiumgrapes@vine}"}\fi
\ifx\florilegiumgrapes@pruning\@empty\else
  \directlua{florilegiumgrapes.pruning = "\luaescapestring{\florilegiumgrapes@pruning}"}\fi
\newcommand\florilegiumgrapespruning[1]{\directlua{florilegiumgrapes.pruning = "\luaescapestring{#1}"}}
\newcommand\florilegiumgrapesvine[1]{\directlua{florilegiumgrapes.vine = "\luaescapestring{#1}"}}
\newcommand\florilegiumgrapesage[1]{\directlua{florilegiumgrapes.age = florilegiumgrapes.number("\string\\florilegiumgrapesage", "\luaescapestring{#1}", nil)}}

%% the page's seed: the page number, and the document's seed if it has one
\def\florilegiumgrapes@seed{%
  \directlua{tex.sprint(florilegiumgrapes.seed(\number\value{page}\ifx\florilegiumgrapesseed\@empty\else,
    florilegiumgrapes.number("\string\\florilegiumgrapesseed", "\luaescapestring{\florilegiumgrapesseed}", nil)\fi))}}

\newcommand\florilegiumgrapes@vinepage{%
\begin{tikzpicture}[overlay]
  \directlua{florilegiumgrapes.twoside = \if@twoside true\else false\fi}%
  \edef\flogr@seed{\florilegiumgrapes@seed}%
  % aging: the sheet's place among all the sheets of the last run, whatever the page numbers
  \ifflorilegiumgrapes@aging\ifnum\PreviousTotalPages>0
    \directlua{florilegiumgrapes.auto_age(\number\ReadonlyShipoutCounter, \PreviousTotalPages)}\fi\fi
  \directlua{florilegiumgrapes.page(\flogr@seed)}%
\end{tikzpicture}}
\ifflorilegiumgrapes@aging
  % the kernel records the number of sheets in the .aux, and the next run reads it back
  % (\PreviousTotalPages); after the last sheet, a run whose count changed asks for another
  \AddToHook{enddocument/afterlastpage}{%
    \ifnum\PreviousTotalPages=\ReadonlyShipoutCounter\else
      \PackageWarningNoLine{florilegium-grapes}{The page count changed. Rerun to get the aging right}\fi}
\fi
\AddToShipoutPictureBG{\AtPageLowerLeft{\put(-\hoffset,\voffset){\florilegiumgrapes@vinepage}}}
\endinput
