%%
%% LuaLaTeX only. The geometry of every leaf, grape and cane is computed in Lua
%% (florilegium-grapes-vine.lua, florilegium-grapes-ink.lua) and written straight into the page as PDF
%% path operators.
%%
%% Usage
%%   \usepackage[vine=pinot]{florilegium-grapes}  a vine of that variety in the margin of every
%%                                       page: pinot (the default), saperavi,
%%                                       gewurztraminer, rkatsiteli, regent, johanniter
%%   \usepackage[aging]{florilegium-grapes}       the vine ages from spring on the first page to
%%                                       autumn on the last (two runs: the page count is
%%                                       read from the .aux of the run before)
%%   \usepackage[pruning=trenzado]{florilegium-grapes}  how the vine is pruned and trained:
%%                                       spur (the default) or trenzado
%%   \florilegiumgrapespruning{style}           the pruning from the page this is set on
%%   \florilegiumgrapesvine{variety}            the variety from the page this is set on
%%   \florilegiumgrapesage{a}                   the season of the following pages: 0 spring,
%%                                       0.5 summer, 1 autumn (default: late summer)
%%   \def\florilegiumgrapesseed{7}               before \usepackage: a fixed seed (any positive
%%                                       integer) instead of the page-number seed
%%
%% The vine grows in the wider side margin: in a two-sided document (twoside, a wide outer
%% margin) it changes sides with the page and is drawn mirrored.
